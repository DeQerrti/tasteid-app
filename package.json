{
  "name": "tasteid",
  "version": "0.1.0",
  "private": true,
  "description": "TasteID — личный паспорт интересов. Настольное приложение: данные лежат папкой на твоём диске.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run check:assets && npm test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "check:assets": "node scripts/check-assets.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "ru.tasteid.app",
    "productName": "TasteID",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "app/icons/icon-512.png",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icons/icon-512.png",
      "category": "Utility"
    }
  }
}
