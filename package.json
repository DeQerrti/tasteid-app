{
  "name": "tasteid",
  "version": "0.3.8",
  "private": true,
  "description": "TasteID — личный паспорт интересов. Настольное приложение: данные лежат папкой на твоём диске.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run check:assets && npm run check:android && npm run check:mobile-links && npm run check:dupes && npm run check:i18n && npm run build:mobile && npm test",
    "check:i18n": "node scripts/check-i18n.js",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "check:assets": "node scripts/check-assets.js",
    "build:mobile": "esbuild mobile/src/main.js --bundle --format=iife --outfile=app/js/mobile.bundle.js --minify --legal-comments=none",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "check:android": "node scripts/check-android.js",
    "check:mobile-links": "node scripts/check-mobile-links.js",
    "check:dupes": "node scripts/check-duplicate-functions.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "ru.tasteid.app",
    "productName": "TasteID",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "core/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "DeQerrti",
      "repo": "tasteid-app"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "app/icons/icon-512.png",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icons/icon-512.png",
      "category": "Utility"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
